+                    continue
+                sigma = {int(lab[x]): y for x, y in zip(slots, assign) if lab[x] >= 0}
+                for W in dict.fromkeys(ends):
+                    win = (lo >= T - 0.11) & (hi < W - 0.05)
+                    new = lab.copy()
+                    for a, b in sigma.items():
