+def single_relabels(ev: Evidence, lab, st: State):
+    """Single relabels of long segments (>= LONG_N detections; clutter ones with P(horse) >= 0.5): each segment to
+    clutter or to every horse whose path is within REL_GATE along the track of the segment's first position; a horse's
+    overlapping segments become clutter. -> list of (segment, label, labelling)."""
+    lo, hi = _seg_bounds(ev)
+    n = np.bincount(ev.seg, minlength=ev.n_seg)
+    ph = np.bincount(ev.seg, ev.p_horse, ev.n_seg) / np.maximum(n, 1)
+    s0 = _seg_first_s(ev)
+    tg = st.tg
+    out = []
+    for x in np.flatnonzero((n >= LONG_N) & ((lab >= 0) | (ph >= 0.5))):
+        k = int(np.clip(np.searchsorted(tg, lo[x]), 0, len(tg) - 1))
+        hs = np.flatnonzero(np.abs(st.S[:, k] - s0[x]) <= REL_GATE)
+        for y in list(hs) + [-1]:
