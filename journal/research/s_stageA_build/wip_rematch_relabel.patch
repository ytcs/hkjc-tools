+        starting = np.flatnonzero((lo >= T - 0.11) & (lo <= T + 0.35) & ((lab >= 0) | (ph >= 0.5)))
+        ending = np.flatnonzero((lab >= 0) & (hi < T - 0.01) & (hi >= T - 0.35))
+        horses = np.unique(np.r_[lab[ending], lab[starting][lab[starting] >= 0]]).astype(int)
+        if not len(horses):
+            continue
+        Sk, Lk = st.S[horses, k], st.L[horses, k]
+        near = (np.abs(Sk[:, None] - Sk[None]) <= EXCH_S) & (np.abs(Lk[:, None] - Lk[None]) <= EXCH_L)
+        groups = set()
+        for a in range(len(horses)):  # each horse with its closest neighbours (by along-track gap) that are near it
+            nb = [b for b in np.argsort(np.abs(Sk - Sk[a])) if near[a, b]][:REMATCH_MAX]
+            groups.add(tuple(sorted(int(horses[b]) for b in nb)))
+        ends = [cuts[i + 1] if i + 1 < len(cuts) else tg[-1] + 1.0, tg[-1] + 1.0]
