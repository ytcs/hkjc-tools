+def _seg_bounds(ev: Evidence):
+    lo = np.full(ev.n_seg, np.inf)
+    hi = np.full(ev.n_seg, -np.inf)
+    np.minimum.at(lo, ev.seg, ev.t)
+    np.maximum.at(hi, ev.seg, ev.t)
+    return lo, hi
+
