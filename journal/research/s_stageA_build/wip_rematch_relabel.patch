+def _seg_first_s(ev: Evidence):
+    o = np.argsort(ev.t, kind="stable")
+    first = np.full(ev.n_seg, -1)
+    first[ev.seg[o[::-1]]] = o[::-1]
+    return ev.s[first]
+
