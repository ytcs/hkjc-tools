+def cut_rematches(ev: Evidence, lab, st: State):
+    """Re-matchings at camera cuts (times where >= 3 labelled segments start together): the horses whose paths are
+    within EXCH_S along and EXCH_L across at the cut form groups (<= REMATCH_MAX, the closest along the track); the
+    group's slots are the segments starting at the cut that are labelled with one of its horses or are clutter with
+    P(horse) >= 0.5 starting within EXCH_S of one of them. Every assignment of the group's labels (each at most once) or
+    clutter to the slots is carried over the stretch to the next cut and to the race's end: a slot's old label maps to
+    its new one on every segment of the stretch; a horse that gets a slot without having held one loses its other
+    segments in the stretch. -> list of (description, labelling)."""
+    from itertools import product
+
+    tg = st.tg
+    lo, hi = _seg_bounds(ev)
+    ph = np.bincount(ev.seg, ev.p_horse, ev.n_seg) / np.maximum(np.bincount(ev.seg, minlength=ev.n_seg), 1)
+    s0 = _seg_first_s(ev)
