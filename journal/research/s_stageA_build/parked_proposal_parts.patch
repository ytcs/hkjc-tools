+def proposal_parts(ev: Evidence, lab, prop):
+    """The changes of an assignment proposal split into independent parts: two changed segments belong to one part
+    when they overlap in time and share a label (old or new), so each part alone keeps per-frame exclusivity.
+    -> list of segment index arrays."""
+    ch = np.flatnonzero(prop != lab)
+    par = np.arange(len(ch))
+
+    def root(i):
+        while par[i] != i:
+            par[i] = par[par[i]]
+            i = par[i]
+        return i
+
+    for i in range(len(ch)):
+        a = ch[i]
+        la = {int(lab[a]), int(prop[a])} - {-1}
+        for j in range(i + 1, len(ch)):
+            b = ch[j]
+            if ev.seg_lo[a] <= ev.seg_hi[b] and ev.seg_hi[a] >= ev.seg_lo[b] and la & ({int(lab[b]), int(prop[b])}):
+                par[root(i)] = root(j)
+    r = np.array([root(i) for i in range(len(ch))], int)
+    return [ch[r == u] for u in np.unique(r)]
+
